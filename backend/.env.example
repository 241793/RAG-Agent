# ===== 应用 =====
APP_NAME=RAG Knowledge Base
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
# 统一入口端口：后端监听此端口，同时托管前端静态文件
PORT=6677

# ===== 数据库（可自由切换，数据用 alembic + 导出脚本迁移）=====
# 默认 SQLite 零依赖；切换示例：
#   PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/rag
#   MySQL:      mysql+asyncmy://root:root@localhost:3306/rag
DATABASE_URL=sqlite+aiosqlite:///./data/rag.db

# ===== 向量 =====
# auto: 依据 DATABASE_URL 自动选择（pg 用 pgvector，其余用 numpy）
# pgvector | numpy
VECTOR_BACKEND=auto
# embedding 维度：bge-m3=1024, text-embedding-3-small=1536, ada-002=1536
# 注意：换 embedding 模型需保证维度一致并重灌知识库
EMBEDDING_DIM=1024

# ===== 安全 =====
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ===== 存储 =====
# local | s3(minio 预留)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/files

# ===== 任务队列 =====
# memory: 进程内 asyncio 队列（零依赖，默认）
# celery: 需 Redis（生产）
TASK_BACKEND=memory
REDIS_URL=redis://localhost:6379/1

# ===== 默认模型 Provider（首次 seed 时写入；也可登录后在前端配置）=====
# 云端 OpenAI 兼容（如中转站）
DEFAULT_LLM_BASE_URL=https://api.zxcbug.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_BASE_URL=https://api.zxcbug.com/v1
DEFAULT_EMBEDDING_API_KEY=
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ===== CORS =====
CORS_ORIGINS=http://localhost:6677,http://127.0.0.1:6677,http://localhost:5173,http://127.0.0.1:5173
